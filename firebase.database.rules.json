{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id', 'name', 'team', 'avatar']) && newData.child('id').val() == auth.uid"
          }
        }
      }
    }
  }
}
